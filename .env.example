# Supabase — proyecto (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor (Route Handlers / Server Actions). Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del taller (E.164, sin +)
NEXT_PUBLIC_WHATSAPP_E164=5215539042880

# Cobro propio por SPEI (transferencia bancaria entrante).
# La CLABE es pública: se muestra al comprador en el checkout para que pague
# desde su banco. Nunca se capturan datos de tarjeta en este sitio.
NEXT_PUBLIC_STORE_CLABE=
NEXT_PUBLIC_STORE_BANK=

# sandbox: el pedido se puede aprobar con un evento firmado de prueba.
# production: la simulación queda deshabilitada por completo.
PAYMENTS_MODE=sandbox
# HMAC de eventos de pago simulados (solo sandbox). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENTS_SANDBOX_SECRET=

# Facturación CFDI 4.0 con Facturapi (solo servidor)
FACTURAPI_KEY=
